{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The AiDEX desktop window: the bridge commands and listening for bridge events, nothing else.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-aidex-status",
    "allow-drive-status",
    "allow-host-profile",
    "allow-sandbox-capabilities",
    "allow-daemon-start",
    "allow-daemon-stop",
    "allow-rpc-call",
    "allow-rpc-call-long",
    "allow-rpc-subscribe",
    "allow-rpc-unsubscribe",
    "allow-select-drive"
  ]
}
